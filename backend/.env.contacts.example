# A backend .env fájljába másolandó, valódi értékekkel.
# A naptár meglévő OAuth-kliense is használható; People API és új redirect URI szükséges.
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
GOOGLE_CONTACTS_REDIRECT_URI=http://127.0.0.1:5174/api/contacts/google/callback
# 64 hexadecimális karakter. Ha üres, a meglévő CALENDAR_TOKEN_KEY használható.
CONTACTS_TOKEN_KEY=
