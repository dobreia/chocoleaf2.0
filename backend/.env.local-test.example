# Copy to .env.local-test. Transfer mode does not need a Stripe key.
# Fill TRANSFER_* in backend/.env; they also appear on the local transfer page.
# The following key is only used by the archived Stripe implementation.
# The local launcher uses a separate database, captures emails locally,
# disables Billingo; the webhook setup is only used in Stripe mode.
STRIPE_SECRET_KEY=

# capture: levelek helyi EML-fájlokban; real: valódi emailküldés.
# real módhoz a backend/.env SMTP- és MAIL-beállításai szükségesek.
LOCAL_MAIL_MODE=capture
