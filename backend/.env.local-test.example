# Copy to .env.local-test and paste your Stripe TEST secret key here.
# The local launcher uses a separate database, captures emails locally,
# disables Billingo and configures the webhook secret automatically.
STRIPE_SECRET_KEY=

# capture: levelek helyi EML-fájlokban; real: valódi emailküldés.
# real módhoz a backend/.env SMTP- és MAIL-beállításai szükségesek.
LOCAL_MAIL_MODE=capture
