# This branch uses bank transfers. Copy these public payment details into backend/.env.
# Fill beneficiary and account (or IBAN) before accepting orders.
TRANSFER_BENEFICIARY=
TRANSFER_BANK_NAME=
TRANSFER_ACCOUNT=
TRANSFER_IBAN=
TRANSFER_SWIFT=
# Stripe/Billingo settings are retained for the previous implementation only.
FRONTEND_URL=http://localhost:5173
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=
# Required explicit accounting configuration; no guessed VAT or invoice type.
# Allowed VAT: 0%, 5%, 18%, 27%, AAM, TAM, ÁKK
BILLINGO_BOOKING_VAT=
BILLINGO_GIFT_VAT=
# invoice or advance; confirm treatment of future workshops and vouchers with your accountant.
BILLINGO_BOOKING_DOCUMENT_TYPE=
BILLINGO_GIFT_DOCUMENT_TYPE=
