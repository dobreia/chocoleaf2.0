# A szerveren backend/.env néven használd, a meglévő titkok megtartásával.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
TRUST_PROXY=1
FRONTEND_URL=https://www.chocoleaf.hu

# A szerveren létrehozott éles adatbázis; ez nem a helyi tesztadatbázis.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=chocoleaf
DB_USER=chocoleaf
DB_PASSWORD=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
MAIL_USER=info@chocoleaf.hu
MAIL_PASS=
MAIL_FROM="ChocoLeaf <info@chocoleaf.hu>"
MAIL_ADMIN=info@chocoleaf.hu

TRANSFER_BENEFICIARY="Braun Edit e.v."
TRANSFER_BANK_NAME="OTP Bank Nyrt."
TRANSFER_ACCOUNT=11773133-09072246

# A Google Cloud OAuth-kliens engedélyezett átirányításaihoz is vedd fel ezeket.
GOOGLE_CONTACTS_REDIRECT_URI=https://www.chocoleaf.hu/api/contacts/google/callback
GOOGLE_CONTACTS_CLIENT_ID=
GOOGLE_CONTACTS_CLIENT_SECRET=
CONTACTS_TOKEN_KEY=
# A naptárszinkron opcionális, csak használata esetén töltsd ki.
GOOGLE_CALENDAR_REDIRECT_URI=https://www.chocoleaf.hu/api/calendar/google/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
CALENDAR_TOKEN_KEY=

# Tartós, az alkalmazást futtató felhasználó számára írható könyvtár.
UPLOAD_DIR=/var/lib/chocoleaf/uploads
