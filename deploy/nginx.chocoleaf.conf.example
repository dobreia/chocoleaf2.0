# Minta: csak a meglévő szerverkonfiguráció és tanúsítvány ellenőrzése után telepítsd.
# A frontend dist könyvtárát és az SSL-fájlok útvonalát igazítsd a szerverhez.
server {
    listen 80;
    server_name chocoleaf.hu www.chocoleaf.hu;
    return 308 https://www.chocoleaf.hu$request_uri;
}

server {
    listen 443 ssl;
    server_name chocoleaf.hu;
    ssl_certificate /etc/letsencrypt/live/chocoleaf.hu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chocoleaf.hu/privkey.pem;
    return 308 https://www.chocoleaf.hu$request_uri;
}

server {
    listen 443 ssl;
    server_name www.chocoleaf.hu;
    ssl_certificate /etc/letsencrypt/live/chocoleaf.hu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chocoleaf.hu/privkey.pem;
    root /var/www/chocoleaf/frontend/dist;
    index index.html;
    client_max_body_size 8m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;

    # Az /api/media útvonalat és a Google callbackeket is továbbítja.
    location /api/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Egyetlen, helyi proxy: ne engedjük át a kliens által küldött IP-láncot.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_cache off;
    }

    location /assets/ {
        try_files $uri =404;
    }

    # A foglaláskezelő és admin aloldalak közvetlenül is megnyithatók.
    location / {
        try_files $uri $uri/ /index.html;
        add_header Cache-Control "no-cache";
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
    }
}
